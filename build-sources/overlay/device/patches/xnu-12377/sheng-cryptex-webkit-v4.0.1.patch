+/* Only the ExtensionKit/Extensions route needs native vnode identity.
+ * A relative lookup from its native parent reuses the caller's authorization
+ * and MAC checks without assigning the alias parent to the native vnode. */
+static int
+bindfs_webkit_native_lookup(vnode_t lower_library, struct componentname *cnp, vnode_t *result, vfs_context_t ctx)
+{
+	static const char next_component[] = "Extensions";
+	struct nameidata *ndp = cnp->cn_ndp;
+	if (ndp == NULL || ndp->ni_rootdir != rootvnode ||
+	    (cnp->cn_flags & (ISLASTCN | NOCROSSMOUNT | CN_NBMOUNTLOOK | CN_FIRMLINK_NOFOLLOW |
+	    CN_RAW_ENCRYPTED | USEDVP | SAVESTART)) ||
+	    (ndp->ni_flag & (NAMEI_ROOTDIR | NAMEI_RESOLVE_BENEATH | NAMEI_NODOTDOT | NAMEI_NOUNION | NAMEI_UNIQUE))) {
+		return 0;
+	}
+
+	const char *next = ndp->ni_next;
+	if (next == NULL || *next != '/') {
+		return 0;
+	}
+	while (*next == '/') {
+		next++;
+	}
+	if (strncmp(next, next_component, sizeof(next_component) - 1) ||
+	    (next[sizeof(next_component) - 1] != '/' && next[sizeof(next_component) - 1] != '\0')) {
+		return 0;
+	}
+
+	const int flags = VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOFOLLOW_ANY | VNODE_LOOKUP_NOCROSSMOUNT;
+	vnode_t native = NULLVP;
+	int error = vnode_lookupat("ExtensionKit", flags, &native, ctx, lower_library);
+	if (error) {
+		return error;
+	}
+
+	vnode_t parent = NULLVP;
+	const char *name = NULL;
+	vnode_getparent_and_name(native, &parent, &name);
+	const bool canonical = parent == lower_library && name && !strcmp(name, "ExtensionKit");
+	if (parent) {
+		vnode_put(parent);
+	}
+	if (name) {
+		vnode_putname(name);
+	}
+	if (canonical && vnode_isdir(native) && !vnode_isvroot(native) &&
+	    vnode_mount(native) == vnode_mount(lower_library) && !vnode_mountedhere(native)) {
+		*result = native;
+	} else {
+		vnode_put(native);
+	}
+	return 0;
+}
