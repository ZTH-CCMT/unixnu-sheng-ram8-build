+static bool
+native_cryptex_webkit_view(vfs_context_t ctx)
+{
+	static const char library[] = "/System/Cryptexes/OS/System/Library";
+	static const char extensions[] = "/System/Cryptexes/OS/System/Library/ExtensionKit/Extensions";
+	static const char canonical[] = "/System/Library/ExtensionKit/Extensions";
+	static const char sibling[] = "/System/Cryptexes/OS/System/Library/Frameworks";
+	vnode_t parent = NULLVP, native = NULLVP, alias = NULLVP, peer = NULLVP;
+	int error = vnode_lookup(library, VNODE_LOOKUP_NOFOLLOW, &parent, ctx);
+	if (!error) {
+		error = vnode_lookup(canonical, VNODE_LOOKUP_NOFOLLOW_ANY, &native, ctx);
+	}
+	if (!error) {
+		error = vnode_lookup(extensions, VNODE_LOOKUP_NOFOLLOW, &alias, ctx);
+	}
+	if (!error) {
+		error = vnode_lookup(sibling, VNODE_LOOKUP_NOFOLLOW, &peer, ctx);
+	}
+	const bool valid = !error && vnode_isdir(peer) && vnode_mount(peer) == vnode_mount(parent) &&
+	    alias == native && vnode_isdir(native) &&
+	    vnode_tag(parent) == VT_BINDFS && vnode_mount(parent) != vnode_mount(native) &&
+	    vnode_mount(native) == vnode_mount(rootvnode);
+	if (peer) {
+		vnode_put(peer);
+	}
+	if (alias) {
+		vnode_put(alias);
+	}
+	if (native) {
+		vnode_put(native);
+	}
+	if (parent) {
+		vnode_put(parent);
+	}
+	return valid;
+}
