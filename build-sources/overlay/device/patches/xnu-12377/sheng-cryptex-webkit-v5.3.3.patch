+static int
+native_webkit_path_prepare(proc_t p, user_addr_t scratch)
+{
+	/* Check every ancestor, one component at a time, before using it. The
+	 * final-component NOFOLLOW check therefore cannot hide an earlier link.
+	 * This runs before user services; no writable parent admits a path race. */
+	static const char *const parents[] = {"/", "/private", "/private/var", "/private/var/ngpu",
+	    "/private/var/ngpu/webkit-v533", "/private/var/ngpu/webkit-v533/Library"};
+	static const char link[] = "/private/var/ngpu/webkit-v533/Library/ExtensionKit";
+	static const char target[] = "/System/Library/ExtensionKit";
+	int error = 0;
+	for (size_t i = 0; i < sizeof(parents) / sizeof(parents[0]); ++i) {
+		error = native_webkit_path_directory(p, scratch, parents[i], i >= 3);
+		if (error) {
+			return error;
+		}
+	}
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	error = vnode_lookup(link, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_uid);
+		if (vnode_vtype(vp) != VLNK) {
+			error = EEXIST; /* Never remove an unexpected file or directory. */
+		} else if (!(error = vnode_getattr(vp, &va, ctx)) &&
+		    (!VATTR_IS_SUPPORTED(&va, va_uid) || va.va_uid != 0)) {
+			error = EPERM;
+		}
+		vnode_put(vp);
+		if (error) {
+			return error;
+		}
+		/* Reuse only our exact link. An unrelated link is not ours to remove. */
+		char value[sizeof(target)];
+		struct readlink_args read = {.path = scratch + 0xc00, .buf = scratch + 0xd00, .count = sizeof(value)};
+		int32_t length = 0;
+		error = copyout(link, read.path, sizeof(link));
+		if (!error) {
+			error = readlink(p, &read, &length);
+		}
+		if (!error && length != (int32_t)(sizeof(target) - 1)) {
+			error = EEXIST;
+		}
+		if (!error) {
+			error = copyin(read.buf, value, sizeof(target) - 1);
+		}
