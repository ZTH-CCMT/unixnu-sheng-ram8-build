+static int
+native_webkit_path_directory(proc_t p, user_addr_t scratch, const char *path, int create)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error == ENOENT && create) {
+		struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+		int32_t result = 0;
+		error = copyout(path, request.path, strlen(path) + 1);
+		if (!error) {
+			error = mkdir(p, &request, &result);
+		}
+		if (error && error != EEXIST) {
+			return error;
+		}
+		error = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	}
+	if (error) {
+		return error;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_mode);
+	if (vnode_vtype(vp) != VDIR) {
+		error = ENOTDIR;
+	} else if (!(error = vnode_getattr(vp, &va, ctx)) &&
+	    (!VATTR_IS_SUPPORTED(&va, va_uid) || !VATTR_IS_SUPPORTED(&va, va_mode) ||
+	    va.va_uid != 0 || (va.va_mode & 0022))) {
+		error = EPERM;
+	}
+	vnode_put(vp);
+	return error;
+}
