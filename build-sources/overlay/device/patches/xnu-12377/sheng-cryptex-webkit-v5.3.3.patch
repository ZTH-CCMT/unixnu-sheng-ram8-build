+		}
+		native_webkit_path_rollback = rollback;
+	}
+	if (!error) {
+		native_webkit_path_stage = 5;
+	}
+ done:
+	if (covered != NULLVP) {
+		vnode_put(covered);
+	}
+	if (sibling != NULLVP) {
+		vnode_put(sibling);
+	}
+	if (root != NULLVP) {
+		vnode_put(root);
+	}
+	native_webkit_path_status = error;
+	printf("[webkit-path] stage=%d status=%d rollback=%d\n", native_webkit_path_stage, error, native_webkit_path_rollback);
+}
