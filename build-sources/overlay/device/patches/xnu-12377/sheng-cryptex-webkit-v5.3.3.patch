+static int
+native_webkit_path_identity(const char *path, vnode_t expected, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP, by_id = NULLVP;
+	struct vnode_attr va, reference;
+	int error = vnode_lookup(path, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_INIT(&reference);
+	VATTR_WANTED(&va, va_fileid);
+	VATTR_WANTED(&reference, va_fileid);
+	if (vp != expected || vnode_mount(vp) != vnode_mount(expected)) {
+		error = EXDEV;
+	} else if (!(error = vnode_getattr(expected, &reference, ctx)) &&
+	    !(error = vnode_getattr(vp, &va, ctx))) {
+		if (!VATTR_IS_SUPPORTED(&reference, va_fileid) || !VATTR_IS_SUPPORTED(&va, va_fileid) ||
+		    va.va_fileid != reference.va_fileid) {
+			error = EINVAL;
+		} else {
+			error = VFS_VGET(vnode_mount(expected), reference.va_fileid, &by_id, ctx);
+			if (!error && (by_id != expected || vnode_mount(by_id) != vnode_mount(expected))) {
+				error = EXDEV;
+			}
+		}
+	}
+	if (by_id != NULLVP) {
+		vnode_put(by_id);
+	}
+	vnode_put(vp);
+	return error;
+}
