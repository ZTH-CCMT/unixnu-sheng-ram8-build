+static void
+native_webkit_canonical_path(proc_t p, user_addr_t scratch)
+{
+	uint32_t enabled = 0;
+	if (!PE_parse_boot_argn("webkit-canonical-path", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	if (native_webkit_path_stage == 5 && native_webkit_path_status == 0) {
+		return; /* Boot setup is idempotent: never stack another shim. */
+	}
+	native_webkit_path_rollback = 0;
+	static const char *const prefixes[] = {"/System/Library/ExtensionKit/Extensions",
+	    "/System/Cryptexes/OS/System/Library/ExtensionKit/Extensions",
+	    "/private/preboot/Cryptexes/OS/System/Library/ExtensionKit/Extensions"};
+	static const char *const bundles[] = {"", "/WebContentExtension.appex", "/NetworkingExtension.appex",
+	    "/GPUExtension.appex", "/WebContentCaptivePortalExtension.appex", "/WebContentEnhancedSecurityExtension.appex"};
+	static const char frameworks[] = "/private/preboot/Cryptexes/OS/System/Library/Frameworks";
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t root = NULLVP, sibling = NULLVP, after = NULLVP, covered = NULLVP;
+	int mounted = 0;
+	int error = native_webkit_path_prepare(p, scratch);
+	native_webkit_path_stage = 1;
+	if (error) {
+		goto done;
+	}
+	native_webkit_path_stage = 2;
+	if ((error = vnode_lookup("/", 0, &root, ctx)) ||
+	    (error = vnode_lookup(frameworks, 0, &sibling, ctx)) ||
+	    (error = vnode_lookup(native_webkit_path_point, 0, &covered, ctx))) {
+		goto done;
+	}
+	if (vnode_isvroot(covered)) {
+		error = EBUSY; /* Do not cover or undo somebody else's Library mount. */
+	}
+	vnode_put(covered);
+	covered = NULLVP;
+	if (error) {
+		goto done;
+	}
+	error = native_cryptex_os_bind(p, scratch, native_webkit_path_source, native_webkit_path_point, MNT_UNION);
+	if (error) {
+		goto done;
+	}
+	mounted = 1;
+	native_webkit_path_stage = 3;
+	for (size_t i = 0; i < sizeof(bundles) / sizeof(bundles[0]) && !error; ++i) {
+		char path[192];
+		vnode_t native = NULLVP;
+		snprintf(path, sizeof(path), "%s%s", prefixes[0], bundles[i]);
+		error = vnode_lookup(path, 0, &native, ctx);
+		if (!error) {
+			/* Same real mount also means the same FSID used for root security
+			 * classification. Do not patch FSID or the underlying mount flags. */
+			if (vnode_mount(native) != vnode_mount(root) || vnode_vtype(native) != VDIR) {
+				error = EXDEV;
+			}
+			for (size_t j = 0; j < sizeof(prefixes) / sizeof(prefixes[0]) && !error; ++j) {
+				snprintf(path, sizeof(path), "%s%s", prefixes[j], bundles[i]);
+				error = native_webkit_path_identity(path, native, ctx);
+			}
+			vnode_put(native);
+		}
+		if (error) {
+			printf("[webkit-path] identity path=%s status=%d\n", path, error);
+		}
+	}
+	if (!error) {
+		native_webkit_path_stage = 4;
+		error = vnode_lookup(frameworks, 0, &after, ctx);
+		if (!error && after != sibling) {
+			error = EXDEV;
+		}
+	}
+	if (after != NULLVP) {
+		vnode_put(after);
+	}
+	if (error && mounted) {
+		/* No new layer vnode remains held here. Undo this mount only;
+		 * the author's existing preboot, System and usr views stay intact. */
+		struct unmount_args undo = {.path = scratch + 0xc00, .flags = 0};
+		int32_t result = 0;
+		int rollback = copyout(native_webkit_path_point, undo.path, sizeof(native_webkit_path_point));
+		if (!rollback) {
