diff --git a/osfmk/ipc/sheng_frame_ipc.h b/osfmk/ipc/sheng_frame_ipc.h
new file mode 100644
index 0000000..58dde39
--- /dev/null
+++ b/osfmk/ipc/sheng_frame_ipc.h
@@ -0,0 +1,56 @@
+#ifndef _IPC_SHENG_FRAME_IPC_H_
+#define _IPC_SHENG_FRAME_IPC_H_
+
+#include <ipc/ipc_kmsg.h>
+#include <kern/task.h>
+#include <vm/vm_kern.h>
+
+enum {
+	SHENG_FRAME_IPC_RECEIVE = 1,
+	SHENG_FRAME_IPC_ENQUEUE,
+	SHENG_FRAME_IPC_WAKE,
+};
+
+/*
+ * The publisher retains target task references (0: SpringBoard, 1: backboardd).
+ * ENQUEUE and WAKE callbacks run with the port locked and must not block.
+ */
+typedef void (*sheng_frame_ipc_hook_t)(uint32_t event, uint32_t slot,
+    uint64_t receiver_tid, uint64_t cookie, int32_t sender_pid,
+    int32_t msgid, uint32_t status);
+
+extern task_t sheng_frame_ipc_tasks[2];
+extern sheng_frame_ipc_hook_t sheng_frame_ipc_hook;
+
+struct sheng_frame_ipc_message {
+	uint64_t cookie;
+	int32_t sender_pid;
+	int32_t msgid;
+};
+
+static inline int
+sheng_frame_ipc_slot(task_t task)
+{
+	if (task != TASK_NULL) {
+		for (unsigned slot = 0; slot < 2; slot++) {
+			if (task == __atomic_load_n(&sheng_frame_ipc_tasks[slot], __ATOMIC_ACQUIRE)) {
+				return (int)slot;
+			}
+		}
+	}
+	return -1;
+}
+
+static inline struct sheng_frame_ipc_message
+sheng_frame_ipc_message(ipc_kmsg_t kmsg)
+{
+	vm_offset_t cookie = 0;
+	vm_kernel_addrperm_external((vm_offset_t)kmsg, &cookie);
+	return (struct sheng_frame_ipc_message) {
+		.cookie = cookie,
+		.sender_pid = (int32_t)ipc_kmsg_get_trailer(kmsg)->msgh_audit.val[5],
+		.msgid = ikm_header(kmsg)->msgh_id,
+	};
+}
+
+#endif /* _IPC_SHENG_FRAME_IPC_H_ */
