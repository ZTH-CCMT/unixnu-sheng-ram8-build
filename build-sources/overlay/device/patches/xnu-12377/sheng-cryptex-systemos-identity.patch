 	}
 	native_cryptex_os_stage = 2;
-	if ((error = native_cryptex_os_bind(p, scratch, "/System", "/private/preboot/Cryptexes/OS/System", 0))) {
+	if ((error = native_cryptex_os_bind(p, scratch, "/System", "/private/preboot/Cryptexes/OS/System", 0, true))) {
 		native_cryptex_os_status = error;
 		return;
 	}
 	native_cryptex_os_stage = 3;
-	if ((error = native_cryptex_os_bind(p, scratch, "/usr", "/private/preboot/Cryptexes/OS/usr", 0))) {
+	if ((error = native_cryptex_os_bind(p, scratch, "/usr", "/private/preboot/Cryptexes/OS/usr", 0, false))) {
 		native_cryptex_os_status = error;
 		return;
 	}
 	native_cryptex_os_stage = 4;
-	error = vnode_lookup("/System/Cryptexes/OS/System/Library/ExtensionKit/Extensions/WebContentExtension.appex/Info.plist", 0, &probe,
-	    vfs_context_current());
+	vfs_context_t ctx = vfs_context_current();
+	error = vnode_lookup("/System/Cryptexes/OS/System/Library/ExtensionKit/Extensions/WebContentExtension.appex/Info.plist",
+	    0, &probe, ctx);
 	if (!error) {
-		vnode_put(probe);
 		native_cryptex_os_stage = 5;
+		error = native_cryptex_systemos_identity(probe, ctx);
+		vnode_put(probe);
+		if (!error) {
+			native_cryptex_os_stage = 6;
+		}
 	}
 	native_cryptex_os_status = error;
 }
