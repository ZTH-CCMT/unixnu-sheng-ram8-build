+
+/* Record whether the WebKit alias resolves to the canonical SystemOS file ID. */
+static int
+native_cryptex_systemos_identity(vnode_t alias, vfs_context_t ctx)
+{
+	static const char extension[] =
+	    "/System/Library/ExtensionKit/Extensions/WebContentExtension.appex/Info.plist";
+	struct vnode_attr attr;
+	vnode_t canonical = NULLVP, resolved = NULLVP, root = NULLVP;
+	int error = vnode_lookup("/", 0, &root, ctx);
+	if (error) {
+		return error;
+	}
+	mount_t systemos = vnode_mount(root);
+	fsid_t fsid = vfs_statfs(systemos)->f_fsid;
+	VATTR_INIT(&attr);
+	VATTR_WANTED(&attr, va_fsid64);
+	error = vnode_getattr(root, &attr, ctx);
+	if (!error && VATTR_IS_SUPPORTED(&attr, va_fsid64) && attr.va_fsid64.val[0] != fsid.val[0]) {
+		error = EINVAL;
+	}
+	if (!error) {
+		VATTR_INIT(&attr);
+		VATTR_WANTED(&attr, va_fsid64);
+		VATTR_WANTED(&attr, va_fileid);
+		error = vnode_getattr(alias, &attr, ctx);
+		if (!error && (!VATTR_ALL_SUPPORTED(&attr) || attr.va_fsid64.val[0] != fsid.val[0] ||
+		    attr.va_fsid64.val[1] != fsid.val[1])) {
+			error = EINVAL;
+		}
+	}
+	if (!error) {
+		error = vnode_getfromid(fsid.val[0], attr.va_fileid, ctx, 0, &resolved);
+	}
+	if (!error) {
+		error = vnode_lookup(extension, 0, &canonical, ctx);
+		if (!error && canonical != resolved) {
+			error = EINVAL;
+		}
+	}
+	if (canonical) {
+		vnode_put(canonical);
+	}
+	if (resolved) {
+		vnode_put(resolved);
+	}
+	vnode_put(root);
+	return error;
+}
