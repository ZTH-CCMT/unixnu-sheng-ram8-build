+static uint64_t
+bindfs_webkit_fileid(vnode_t vp, vfs_context_t ctx)
+{
+	struct vnode_attr attr;
+	if (!vnode_isdir(vp) || vnode_isvroot(vp)) {
+		return 0;
+	}
+	VATTR_INIT(&attr);
+	VATTR_WANTED(&attr, va_fileid);
+	if (vnode_getattr(vp, &attr, ctx) || !VATTR_IS_SUPPORTED(&attr, va_fileid)) {
+		return 0;
+	}
+	return attr.va_fileid;
+}
+
+/*
+ * Resolve the original Apple bundles through the authenticated read-only
+ * SystemOS backing tree, without following links or crossing a mount.
+ * Keep the whole directory scan on ordinary bindfs. Only these bundle
+ * directories get a logical SystemOS volume ID for LaunchServices.
+ */
+static void
+bindfs_prepare_webkit_identity(struct bind_mount *bindm, vnode_t lowerrootvp, vfs_context_t ctx)
+{
+	static const char *const bundle_names[BIND_WEBKIT_BUNDLE_COUNT] = {
+		"WebContentExtension.appex",
+		"WebContentEnhancedSecurityExtension.appex",
+		"WebContentCaptivePortalExtension.appex",
+		"GPUExtension.appex",
+		"NetworkingExtension.appex",
+	};
+	const int lookup_flags = VNODE_LOOKUP_NOFOLLOW_ANY | VNODE_LOOKUP_NOCROSSMOUNT;
+	mount_t lower_mount = vnode_mount(lowerrootvp);
+	vnode_t directory = NULLVP;
+	if (vnode_getwithref(lowerrootvp)) {
+		return;
+	}
+	int error = vnode_lookupat("Library/ExtensionKit/Extensions", lookup_flags,
+	    &directory, ctx, lowerrootvp);
+	vnode_put(lowerrootvp);
+	if (error) {
+		return;
+	}
+	if (!vnode_isdir(directory) || vnode_mount(directory) != lower_mount) {
+		vnode_put(directory);
+		return;
+	}
+	for (unsigned i = 0; i < BIND_WEBKIT_BUNDLE_COUNT; i++) {
+		vnode_t bundle = NULLVP, resolved = NULLVP;
+		error = vnode_lookupat(bundle_names[i], lookup_flags, &bundle, ctx, directory);
+		if (error) {
+			break;
+		}
+		uint64_t id = vnode_mount(bundle) == lower_mount ? bindfs_webkit_fileid(bundle, ctx) : 0;
+		error = id ? VFS_VGET(lower_mount, id, &resolved, ctx) : EINVAL;
+		if (!error && resolved != bundle) {
+			error = EINVAL;
+		}
+		if (resolved) {
+			vnode_put(resolved);
+		}
+		vnode_put(bundle);
+		if (error) {
+			break;
+		}
+		bindm->bindm_webkit_fileids[i] = id;
+	}
+	vnode_put(directory);
+	if (!error) {
+		bindm->bindm_flags |= BINDM_WEBKIT_SYSTEMOS;
+	}
+}
+
+bool
+bindfs_webkit_systemos_fsid(struct bind_mount *bindm, vnode_t lowervp, fsid_t *fsid, vfs_context_t ctx)
+{
+	if (!(bindm->bindm_flags & BINDM_WEBKIT_SYSTEMOS)) {
+		return false;
+	}
+	mount_t lower_mount = vnode_mount(lowervp);
+	if (lower_mount != vnode_mount(bindm->bindm_lowerrootvp) ||
+	    !(vfs_flags(lower_mount) & MNT_RDONLY)) {
+		return false;
+	}
+	const uint64_t id = bindfs_webkit_fileid(lowervp, ctx);
+	if (!id) {
+		return false;
+	}
+	for (unsigned i = 0; i < BIND_WEBKIT_BUNDLE_COUNT; i++) {
+		if (id == bindm->bindm_webkit_fileids[i]) {
+			*fsid = vfs_statfs(lower_mount)->f_fsid;
+			return true;
+		}
+	}
+	return false;
+}
