+	if (ino == BIND_ROOT_INO) {
+		error = vnode_getwithref(bindm->bindm_rootvp);
+		if (!error) { *vpp = bindm->bindm_rootvp; }
+		return error;
+	}
+	error = VFS_VGET(vnode_mount(bindm->bindm_lowerrootvp), ino, &lowervp, ctx);
+	if (error) {
+		return error;
+	}
+	if (lowervp == bindm->bindm_lowerrootvp) {
+		vnode_put(lowervp);
+		error = vnode_get(bindm->bindm_rootvp);
+		if (error == 0) {
+			*vpp = bindm->bindm_rootvp;
+		}
+		return error;
+	}
+	lowerpath = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_NOFAIL);
+	rootpath = kalloc_data(MAXPATHLEN, Z_WAITOK | Z_NOFAIL);
+	len = MAXPATHLEN;
+	error = vn_getpath(lowervp, lowerpath, &len);
+	vnode_put(lowervp);
+	if (error == 0) {
+		error = vnode_getwithref(bindm->bindm_lowerrootvp);
+		if (!error) {
+			len = MAXPATHLEN;
+			error = vn_getpath(bindm->bindm_lowerrootvp, rootpath, &len);
+			vnode_put(bindm->bindm_lowerrootvp);
+		}
+	}
+	if (error == 0) {
+		rootlen = strlen(rootpath);
+		if (rootlen == 1 && rootpath[0] == '/') {
+			relative = lowerpath + 1;
+		} else if (strncmp(lowerpath, rootpath, rootlen) == 0 && lowerpath[rootlen] == '/') {
+			relative = lowerpath + rootlen + 1;
+		}
+		error = relative && *relative ? vnode_getwithref(bindm->bindm_rootvp) : ENOENT;
+		if (!error) {
+			/* An alias FSID must reverse-resolve to the alias view, including
+			 * covered entries from NOCROSS bulk enumeration. The native FSID
+			 * uses APFS VGET independently. Never mix the two namespaces. */
+			error = vnode_lookupat(relative, VNODE_LOOKUP_NOFOLLOW | VNODE_LOOKUP_NOCROSSMOUNT,
+			    vpp, ctx, bindm->bindm_rootvp);
+			vnode_put(bindm->bindm_rootvp);
+		}
+	}
+	kfree_data(lowerpath, MAXPATHLEN);
+	kfree_data(rootpath, MAXPATHLEN);
+	return error;
+}
+
+static int
+bindfs_vget(struct mount *mp, ino64_t ino, struct vnode **vpp, vfs_context_t ctx)
+{
+	struct bind_mount *bindm = MOUNTTOBINDMOUNT(mp);
+	if (bindm && (bindm->bindm_flags & BINDM_WEBKIT_NATIVE)) {
+		return bindfs_webkit_vget(mp, ino, vpp, ctx);
+	}
+	return bindfs_legacy_vget(mp, ino, vpp, ctx);
 }
 
