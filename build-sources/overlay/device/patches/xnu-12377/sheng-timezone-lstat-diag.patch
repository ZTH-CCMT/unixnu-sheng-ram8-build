 }
 
 int
-lstat64(__unused proc_t p, struct lstat64_args *uap, __unused int32_t *retval)
-{
-	return fstatat_internal(vfs_context_current(), uap->path, uap->ub,
-	           0, 0, 1, UIO_USERSPACE, AT_FDCWD, AT_SYMLINK_NOFOLLOW);
+lstat64(proc_t p, struct lstat64_args *uap, __unused int32_t *retval)
+{
+	vfs_context_t ctx = vfs_context_current();
+	if (proc_pid(p) != 1 || !native_tz_enabled()) {
+		return fstatat_internal(ctx, uap->path, uap->ub,
+		           0, 0, 1, UIO_USERSPACE, AT_FDCWD, AT_SYMLINK_NOFOLLOW);
+	}
+
+	struct native_tz_probe probe = {};
+	const uint64_t candidate = os_atomic_inc_orig(&native_tz_candidates, relaxed);
+	// Mix before selection so interleaving two paths cannot hide all of one.
+	const uint64_t sample_key = (candidate ^ (candidate >> 16)) * 0x9e3779b97f4a7c15ULL;
+	probe.sample_cpu = candidate < 8 || (sample_key >> 59) == 0;
+	const uint64_t wall = mach_absolute_time();
+	const uint64_t cpu = probe.sample_cpu ? thread_get_runtime_self() : 0;
+	const int error = fstatat_internal_with_probe(ctx, uap->path, uap->ub,
+	    0, 0, 1, UIO_USERSPACE, AT_FDCWD, AT_SYMLINK_NOFOLLOW, &probe);
+	native_tz_finish(&probe, error, wall, cpu);
+	return error;
 }
 
