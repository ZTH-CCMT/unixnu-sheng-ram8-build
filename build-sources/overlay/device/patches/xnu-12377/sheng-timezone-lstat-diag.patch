+/* Optional, cumulative diagnostic for launchd's exact timezone lstat64. */
+#define NATIVE_TZ_SLOTS 32
+#define NATIVE_TZ_FIELDS 22
+static struct {
+	struct nameidata *key;
+	struct native_tz_probe *probe;
+} native_tz_slots[NATIVE_TZ_SLOTS];
+static uint64_t native_tz_stats[NATIVE_TZ_FIELDS];
+static uint64_t native_tz_candidates;
+static unsigned int native_tz_state;
+
+enum {
+	TZ_CALL, TZ_OK, TZ_ENOENT, TZ_OTHER, TZ_WALL, TZ_LOOKUP_WALL, TZ_ATTRS_WALL,
+	TZ_ROOT_COUNT, TZ_ROOT_WALL, TZ_RECURSE_COUNT, TZ_RECURSE_WALL,
+	TZ_CPU, TZ_CPU_COUNT, TZ_LOST, TZ_LAST_ERRNO, TZ_ENABLED,
+	TZ_LOOKUP_CPU, TZ_ATTRS_CPU, TZ_ROOT_CPU, TZ_RECURSE_CPU,
+	TZ_ROOT_CPU_COUNT, TZ_RECURSE_CPU_COUNT
+};
+
+static bool
+native_tz_enabled(void)
+{
+	unsigned int state = os_atomic_load(&native_tz_state, relaxed);
+	if (state == 0) {
+		int boot_arg = 0;
+		state = PE_parse_boot_argn("tz-diag", &boot_arg, sizeof(boot_arg)) && boot_arg == 1 ? 2 : 1;
+		os_atomic_store(&native_tz_state, state, relaxed);
+	}
+	return state == 2;
+}
+
+static unsigned int
+native_tz_slot(const struct nameidata *ndp)
+{
+	const uintptr_t key = (uintptr_t)ndp;
+	return ((key >> 4) ^ (key >> 12)) & (NATIVE_TZ_SLOTS - 1);
+}
+
+struct native_tz_probe *
+native_tz_find(const struct nameidata *ndp)
+{
+	if (os_atomic_load(&native_tz_state, relaxed) != 2) {
+		return NULL;
+	}
+	const unsigned int slot = native_tz_slot(ndp);
+	if (os_atomic_load(&native_tz_slots[slot].key, acquire) == ndp) {
+		return native_tz_slots[slot].probe;
+	}
+	return NULL;
+}
+
+static bool
+native_tz_track(struct nameidata *ndp, struct native_tz_probe *probe)
+{
+	const unsigned int slot = native_tz_slot(ndp);
+	if (!os_atomic_cmpxchg(&native_tz_slots[slot].key, NULL, ndp, acquire)) {
+		os_atomic_inc(&native_tz_stats[TZ_LOST], relaxed);
+		return false;
+	}
+	// Only this nameidata's synchronous namei calls read probe. Other threads
+	// check their own nameidata against key and do not touch its observation.
+	native_tz_slots[slot].probe = probe;
+	return true;
+}
+
+static void
+native_tz_untrack(struct nameidata *ndp)
+{
+	const unsigned int slot = native_tz_slot(ndp);
+	native_tz_slots[slot].probe = NULL;
+	os_atomic_store(&native_tz_slots[slot].key, NULL, release);
+}
+
+void
+native_tz_snapshot(uint64_t *out)
+{
+	for (unsigned int i = 0; i < NATIVE_TZ_FIELDS; ++i) {
+		out[i] = os_atomic_load(&native_tz_stats[i], relaxed);
+	}
+	out[TZ_ENABLED] = native_tz_enabled();
+}
+
+static void
+native_tz_finish(const struct native_tz_probe *probe, int error,
+    uint64_t begin_wall, uint64_t begin_cpu)
+{
+	if (!probe->matched) {
+		return;
+	}
+	const uint64_t cpu = probe->sample_cpu ? thread_get_runtime_self() - begin_cpu : 0;
+	const uint64_t wall = mach_absolute_time() - begin_wall;
+	if (error == 0) {
+		os_atomic_inc(&native_tz_stats[TZ_OK], relaxed);
+	} else if (error == ENOENT) {
+		os_atomic_inc(&native_tz_stats[TZ_ENOENT], relaxed);
+	} else {
+		os_atomic_inc(&native_tz_stats[TZ_OTHER], relaxed);
+		os_atomic_store(&native_tz_stats[TZ_LAST_ERRNO], (uint64_t)error, relaxed);
+	}
+	os_atomic_add(&native_tz_stats[TZ_WALL], wall, relaxed);
+	os_atomic_add(&native_tz_stats[TZ_LOOKUP_WALL], probe->lookup_wall, relaxed);
+	os_atomic_add(&native_tz_stats[TZ_ATTRS_WALL], probe->attrs_wall, relaxed);
+	if (probe->root_count) {
+		os_atomic_add(&native_tz_stats[TZ_ROOT_COUNT], probe->root_count, relaxed);
+		os_atomic_add(&native_tz_stats[TZ_ROOT_WALL], probe->root_wall, relaxed);
+	}
+	if (probe->recurse_count) {
+		os_atomic_add(&native_tz_stats[TZ_RECURSE_COUNT], probe->recurse_count, relaxed);
+		os_atomic_add(&native_tz_stats[TZ_RECURSE_WALL], probe->recurse_wall, relaxed);
+	}
+	if (probe->sample_cpu) {
+		os_atomic_add(&native_tz_stats[TZ_CPU], cpu, relaxed);
+		os_atomic_add(&native_tz_stats[TZ_LOOKUP_CPU], probe->lookup_cpu, relaxed);
+		os_atomic_add(&native_tz_stats[TZ_ATTRS_CPU], probe->attrs_cpu, relaxed);
+		if (probe->root_count) {
+			os_atomic_add(&native_tz_stats[TZ_ROOT_CPU], probe->root_cpu, relaxed);
+			os_atomic_add(&native_tz_stats[TZ_ROOT_CPU_COUNT], probe->root_count, relaxed);
+		}
+		if (probe->recurse_count) {
+			os_atomic_add(&native_tz_stats[TZ_RECURSE_CPU], probe->recurse_cpu, relaxed);
+			os_atomic_add(&native_tz_stats[TZ_RECURSE_CPU_COUNT], probe->recurse_count, relaxed);
+		}
+		os_atomic_inc(&native_tz_stats[TZ_CPU_COUNT], relaxed);
+	}
+	os_atomic_inc(&native_tz_stats[TZ_CALL], relaxed);
+}
