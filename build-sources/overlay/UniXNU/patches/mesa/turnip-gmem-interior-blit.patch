+/* The event blit can round past an imported image's edge. For a full-size
+ * single-layer BGRA target, use it only on bins wholly inside the aligned
+ * rectangle. The exact load/store still covers every bin crossing that edge.
+ */
+static bool
+tu_enable_gmem_interior_blit(struct tu_cmd_buffer *cmd,
+                             const struct tu_image_view *iview)
+{
+#ifndef __APPLE__
+   return false;
+#endif
+   const struct tu_physical_device *phys_dev = cmd->device->physical_device;
+   const struct tu_framebuffer *fb = cmd->state.framebuffer;
+   const VkRect2D &area = cmd->state.render_areas[0];
+   if (phys_dev->dev_id.gpu_id != 740 || cmd->state.pass->has_fdm ||
+       cmd->state.pass->num_views > 1 || fb->layers != 1 ||
+       cmd->state.per_layer_render_area ||
+       iview->vk.format != VK_FORMAT_B8G8R8A8_UNORM ||
+       iview->view.is_mutable || iview->image->vk.samples != VK_SAMPLE_COUNT_1_BIT ||
+       area.offset.x != 0 || area.offset.y != 0 ||
+       area.extent.width != fb->width || area.extent.height != fb->height ||
+       iview->view.width != fb->width || iview->view.height != fb->height ||
+       !tu_attachment_unpadded(cmd, iview))
+      return false;
+
+   const auto *info = phys_dev->info;
+   const VkExtent2D interior = {
+      fb->width - fb->width % info->gmem_align_w,
+      fb->height - fb->height % info->gmem_align_h,
+   };
+   const auto &tile = cmd->state.tiling->tile0;
+   if (!tile.width || !tile.height || tile.width > interior.width ||
+       tile.height > interior.height || tile.width % info->gmem_align_w ||
+       tile.height % info->gmem_align_h)
+      return false;
+
+   cmd->state.rp.gmem_blit_interior = interior;
+   return true;
+}
